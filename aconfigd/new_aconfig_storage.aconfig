package: "com.android.aconfig_new_storage"
container: "system"

flag {
  name: "enable_aconfig_storage_daemon"
  namespace: "core_experiments_team_internal"
  description: "This flag controls if aconfig storage daemon is turned on"
  bug: "312444587"
  is_fixed_read_only: true
}

flag {
    name: "support_immediate_local_overrides"
    namespace: "core_experiments_team_internal"
    description: "Support immediate local overrides."
    bug: "360205436"
}

flag {
    name: "support_clear_local_overrides_immediately"
    namespace: "core_experiments_team_internal"
    description: "Support ability to clear local overrides immediately."
    bug: "360205436"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
  name: "enable_aconfigd_from_mainline"
  namespace: "core_experiments_team_internal"
  bug: "369808805"
  description: "When enabled, launch aconfigd from config infra module."
  is_fixed_read_only: true
}

flag {
    name: "enable_earlier_aconfigd"
    namespace: "core_experiments_team_internal"
    description: "enable earlier boot aconfigd, move aconfigd start from post-fs to early-init"
    is_fixed_read_only: true
    bug: "427267284"
}

flag {
    name: "read_only_flag_for_test"
    namespace: "performance"
    description: "Read-only flag for perf testing."
    is_fixed_read_only: true
    bug: "447177427"
}

flag {
    name: "read_write_flag_for_test"
    namespace: "performance"
    description: "Read/write flag for perf testing."
    bug: "447177427"
}

flag {
    name: "stop_loading_flag_default_value"
    namespace: "core_experiments_team_internal"
    description: "stop loading flag default value into device_config."
    bug: "450109314"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "detect_device_build_switch"
    namespace: "core_experiments_team_internal"
    description: "detect device build type change and clear all overrides"
    bug: "467066835"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
    is_fixed_read_only: true
}

flag {
    name: "enable_bootloader_sync"
    namespace: "core_experiments_team_internal"
    description: "aconfigd will sync certain flags to misc partition for the bootloader to read"
    bug: "477200886"
    is_fixed_read_only: true
}
